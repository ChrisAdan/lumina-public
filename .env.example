# Copy this file to .env and fill in your values.
# The .env file is symlinked from .env (-> .env.prod by default).
# Use --env-file .env.dev for a lighter dev config.

# ── Identity ───────────────────────────────────────────────────────────────────
USER_NAME=Your Name
USER_EMAIL=you@example.com

# ── Postgres ───────────────────────────────────────────────────────────────────
POSTGRES_USER=lumina
POSTGRES_PASSWORD=changeme
POSTGRES_DB=lumina

# ── Ollama model tags ──────────────────────────────────────────────────────────
# The model Lumina uses by default for all conversations
OLLAMA_MODEL=lumina-prod
# Optional: heavier model for reasoning-intensive tasks (/reason prefix)
# OLLAMA_HEAVY_MODEL=lumina-prod-30b

# ── Open WebUI ─────────────────────────────────────────────────────────────────
WEBUI_SECRET_KEY=change-this-to-a-random-string

# ── ntfy push notifications ────────────────────────────────────────────────────
# Self-hosted ntfy (see docker-compose.yml). Update the base-url in ntfy's
# compose command to your server IP for external push to work.
NTFY_URL=http://localhost:8002
NTFY_TOPIC=lumina

# ── Weather ────────────────────────────────────────────────────────────────────
# Open-Meteo is used (no API key needed). Set your coordinates:
# WEATHER_LAT=40.7128
# WEATHER_LON=-74.0060
# WEATHER_LOCATION_NAME=New York, NY

# ── Google integrations (Calendar + Gmail) ─────────────────────────────────────
# Download OAuth credentials from Google Cloud Console (Desktop app type).
# Run `python services/google_auth.py` once to generate token.json.
GOOGLE_CREDENTIALS_PATH=/app/credentials.json
GOOGLE_TOKEN_PATH=/app/token.json

# Calendar sync lookahead window
CALENDAR_LOOKAHEAD_DAYS=30

# Gmail: how many days back to sync on first run
GMAIL_LOOKBACK_DAYS=7
# Gmail: comma-separated label names to exclude (e.g. promotions, spam)
GMAIL_EXCLUDED_LABELS=CATEGORY_PROMOTIONS,SPAM

# ── People / contacts sync ─────────────────────────────────────────────────────
LUMINA_PEOPLE_CONTEXT_ENABLED=true
# How often to sync Synapses/<Name>.md files into the people table (minutes)
LUMINA_PEOPLE_SYNC_INTERVAL_MINUTES=30

# ── Context pruning ────────────────────────────────────────────────────────────
# Number of conversation turns to keep in context before pruning
LUMINA_PRUNE_KEEP_TURNS=20

# ── Lumina modes ───────────────────────────────────────────────────────────────
LUMINA_MODES_ENABLED=true

# ── Metabase (optional analytics UI) ──────────────────────────────────────────
# METABASE_DB_NAME=metabase
